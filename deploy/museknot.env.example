NODE_ENV=production
MUSEKNOT_HOST=127.0.0.1
PORT=4173
MUSEKNOT_ORIGIN=https://notes.example.com
MUSEKNOT_BASE_PATH=/museknot
MUSEKNOT_TRUST_PROXY=1
MUSEKNOT_DATA_DIR=/var/lib/museknot
MUSEKNOT_BACKUP_DIR=/var/backups/museknot
# Set a random secret before allowing registrations; empty disables registration.
MUSEKNOT_INVITE_CODE=
